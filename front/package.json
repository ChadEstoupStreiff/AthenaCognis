{
  "name": "athenacognis-front-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "screenshots": "playwright test -c e2e/screenshots.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@fontsource/inter": "5.3.0",
    "@primeuix/themes": "2.0.3",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "extendable-media-recorder": "9.2.40",
    "extendable-media-recorder-wav-encoder": "7.0.140",
    "fflate": "0.8.2",
    "fuse.js": "7.5.0",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "marked-highlight": "2.2.4",
    "ngx-echarts": "21.0.0",
    "papaparse": "5.7.0",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "read-excel-file": "9.3.12",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "utif2": "4.1.0",
    "vis-data": "8.0.5",
    "vis-network": "10.1.2"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "angular-eslint": "21.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
