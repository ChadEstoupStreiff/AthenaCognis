# Name shown in the greeting on the Home page (front).
USER_NAME=Chad

# ─── Paths (host machine) ────────────────────────────────────────────────────
# Folder on the host where all persistent data is kept: database files,
# Ollama models, Whisper/Paddle caches, shared uploads. Back it up.
DATA_PATH=/data/AthenaCognis
# Host folder mounted read-only at /local in the database (back_db) and backend
# containers. The Activity page watches folders picked inside it for file changes.
LOCAL_PATH=/Users/chad

# ─── Ports (host side) ───────────────────────────────────────────────────────
# Port for the backend API (FastAPI). The front already proxies /api to it,
# so only open this port for direct API access or debugging.
BACK_PORT=8400
# Port for the web interface. Open http://localhost:8401 in a browser.
FRONT_PORT=8401
# Port for phpMyAdmin, a web UI to inspect the database directly.
PMA_PORT=8402

# ─── Database ────────────────────────────────────────────────────────────────
# Root password for MariaDB. The backend and phpMyAdmin use it to connect.
# Set it before first start: it is fixed when the database is created, and
# changing it later does not update an existing database.
DATABASE_PASSWORD=XXXXXXXX

# ─── Telemetry (optional) ────────────────────────────────────────────────────
# Anonymous usage statistics: sent only after consent in Settings, at most
# one ping a day. Leave both empty to turn telemetry off completely.
# URL of the separately deployed telemetry service that receives the pings.
TELEMETRY_SERVER_URL=https://telemetryathenacognis.chades.fr
# URL of the public statistics dashboard, linked from Settings.
TELEMETRY_DASHBOARD_URL=https://athenacognis.chades.fr
